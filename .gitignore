.DS_Store
.matplotlib-cache/
__pycache__/
*.pyc
.venv/
training_runs/
.cache/
tmp/

# Regenerable CFD and intermediate datasets. Publish archival snapshots
# separately (for example, Zenodo) and record their checksums.
corrected_production/
corrected_full/
corrected_pilot/
corrected_symmetry/
corrected_symmetry_refined/
corrected_symmetry_split/
data/raw_cases/
data/processed_grids/
data/openfoam_cases/
/data/metadata.csv
/data/normalization.npy
/openfoam_cases/
/figures/
/zenodo_release/

# Generated optimization solver cases can be reconstructed from summaries.
hso_results/**/openfoam_cases/
hso_results/**/openfoam_validation/
/hso_results/fno_screen/

# Publish only the corrected paper results, not legacy pilot evaluations.
/paper_results/*
!/paper_results/corrected/
!/paper_results/corrected/**
!/paper_results/corrected_results_report.md

# LaTeX build products; source and final PDFs remain trackable.
papers/**/*.aux
papers/**/*.bbl
papers/**/*.blg
papers/**/*.log
papers/**/*.out
papers/**/*.synctex.gz
papers/**/main.pdf
output/pdf/*_draft.pdf

# OpenFOAM runtime logs and processor decompositions can get large quickly.
openfoam_cases/**/log.*
openfoam_cases/**/processor*/
